<?xml version="1.0"?>
<sdf version="1.10">
  <model name="demo_robot" xmlns:gz="http://gazebosim.org/schema">
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- The chassis is 0.17 m long (X) and 0.20 m wide (Y). -->
    <link name="base_link">
      <pose>0 0 0.08 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.01933</ixx>
          <iyy>0.01471</iyy>
          <izz>0.02671</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.17 0.20 0.08</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.17 0.20 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.25 0.65 1</ambient>
          <diffuse>0.10 0.35 0.90 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- Yellow bar marks the robot's +X (forward) side. -->
      <visual name="front_marker">
        <pose>0.088 0 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.012 0.12 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.75 0.0 1</ambient>
          <diffuse>1.0 0.75 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.045 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu</topic>
      </sensor>
    </link>

    <!-- Wheel collisions use diagonal friction directions to approximate
         mecanum rollers while keeping the model lightweight. -->
    <link name="front_left_wheel">
      <pose>0.085 0.115 0.06 -1.570796 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000195</ixx>
          <iyy>0.000195</iyy>
          <izz>0.000360</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.06</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.085 -0.115 0.06 -1.570796 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000195</ixx>
          <iyy>0.000195</iyy>
          <izz>0.000360</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.06</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.085 0.115 0.06 -1.570796 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000195</ixx>
          <iyy>0.000195</iyy>
          <izz>0.000360</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.06</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.085 -0.115 0.06 -1.570796 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000195</ixx>
          <iyy>0.000195</iyy>
          <izz>0.000360</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.06</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>20</effort><velocity>100</velocity></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>20</effort><velocity>100</velocity></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>20</effort><velocity>100</velocity></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>20</effort><velocity>100</velocity></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-mecanum-drive-system"
            name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>0.23</wheel_separation>
      <wheelbase>0.17</wheelbase>
      <wheel_radius>0.06</wheel_radius>
      <min_acceleration>-15</min_acceleration>
      <max_acceleration>15</max_acceleration>
      <topic>/sim_cmd_vel</topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states_gz</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <update_rate>100</update_rate>
    </plugin>
  </model>
</sdf>
